   "source": [
    "from modeling import svm_optimized\n",
    "\n",
    "svm_model = svm_optimized(Xcalclass_prep, ycalclass, Xpredclass_prep, ypredclass, aim='classification', kernel='rbf')\n",
    "svm_model[0]"
   ]
